<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ticket-process" name="Support ticket" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="Start" name="Ticket created"/>
    <bpmn:serviceTask id="Task_SetOpen" name="Set status OPEN" camunda:expression="${ticketWorkflow.setStatus(execution, 'OPEN')}"/>
    <bpmn:exclusiveGateway id="Gateway_Priority" name="Urgent?" default="Flow_Standard"/>
    <bpmn:userTask id="Task_Urgent" name="Handle urgent ticket" camunda:candidateGroups="senior-agents"/>
    <bpmn:userTask id="Task_Standard" name="Handle ticket" camunda:candidateGroups="support-agents"/>
    <bpmn:boundaryEvent id="Timer_Escalation" name="24h SLA" cancelActivity="false" attachedToRef="Task_Standard">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Escalate" name="Escalate ticket" camunda:expression="${ticketWorkflow.escalate(execution)}"/>
    <bpmn:endEvent id="End_Escalated" name="Escalation sent"/>
    <bpmn:exclusiveGateway id="Gateway_Merge"/>
    <bpmn:serviceTask id="Task_SetResolved" name="Set status RESOLVED" camunda:expression="${ticketWorkflow.setStatus(execution, 'RESOLVED')}"/>
    <bpmn:userTask id="Task_Validate" name="Validate resolution" camunda:candidateGroups="admins"/>
    <bpmn:serviceTask id="Task_SetClosed" name="Set status CLOSED" camunda:expression="${ticketWorkflow.setStatus(execution, 'CLOSED')}"/>
    <bpmn:endEvent id="End_Closed" name="Ticket closed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_SetOpen"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SetOpen" targetRef="Gateway_Priority"/>
    <bpmn:sequenceFlow id="Flow_Urgent" name="URGENT" sourceRef="Gateway_Priority" targetRef="Task_Urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${priority == 'URGENT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Standard" name="other" sourceRef="Gateway_Priority" targetRef="Task_Standard"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Urgent" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Standard" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Merge" targetRef="Task_SetResolved"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SetResolved" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Validate" targetRef="Task_SetClosed"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SetClosed" targetRef="End_Closed"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Timer_Escalation" targetRef="Task_Escalate"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Escalate" targetRef="End_Escalated"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="ticket-process">
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="152" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SetOpen" bpmnElement="Task_SetOpen"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GwPriority" bpmnElement="Gateway_Priority" isMarkerVisible="true"><dc:Bounds x="395" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Urgent" bpmnElement="Task_Urgent"><dc:Bounds x="520" y="20" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Standard" bpmnElement="Task_Standard"><dc:Bounds x="520" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Timer" bpmnElement="Timer_Escalation"><dc:Bounds x="552" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Escalate" bpmnElement="Task_Escalate"><dc:Bounds x="620" y="290" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEsc" bpmnElement="End_Escalated"><dc:Bounds x="772" y="312" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GwMerge" bpmnElement="Gateway_Merge" isMarkerVisible="true"><dc:Bounds x="700" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Resolved" bpmnElement="Task_SetResolved"><dc:Bounds x="810" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Validate" bpmnElement="Task_Validate"><dc:Bounds x="960" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Closed" bpmnElement="Task_SetClosed"><dc:Bounds x="1110" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndClosed" bpmnElement="End_Closed"><dc:Bounds x="1262" y="102" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_1" bpmnElement="Flow_1"><di:waypoint x="188" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_2" bpmnElement="Flow_2"><di:waypoint x="340" y="120"/><di:waypoint x="395" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Urgent" bpmnElement="Flow_Urgent"><di:waypoint x="420" y="95"/><di:waypoint x="420" y="60"/><di:waypoint x="520" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Standard" bpmnElement="Flow_Standard"><di:waypoint x="420" y="145"/><di:waypoint x="420" y="200"/><di:waypoint x="520" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_3" bpmnElement="Flow_3"><di:waypoint x="620" y="60"/><di:waypoint x="725" y="60"/><di:waypoint x="725" y="95"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_4" bpmnElement="Flow_4"><di:waypoint x="620" y="200"/><di:waypoint x="725" y="200"/><di:waypoint x="725" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_5" bpmnElement="Flow_5"><di:waypoint x="750" y="120"/><di:waypoint x="810" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_6" bpmnElement="Flow_6"><di:waypoint x="910" y="120"/><di:waypoint x="960" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_7" bpmnElement="Flow_7"><di:waypoint x="1060" y="120"/><di:waypoint x="1110" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_8" bpmnElement="Flow_8"><di:waypoint x="1210" y="120"/><di:waypoint x="1262" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_9" bpmnElement="Flow_9"><di:waypoint x="570" y="258"/><di:waypoint x="570" y="330"/><di:waypoint x="620" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_10" bpmnElement="Flow_10"><di:waypoint x="720" y="330"/><di:waypoint x="772" y="330"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
